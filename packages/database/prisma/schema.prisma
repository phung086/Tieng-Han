generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Skill {
  VOCABULARY
  GRAMMAR
  LISTENING
  SPEAKING
  READING
  WRITING
}

enum QuizType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCHING
  FILL_BLANK
  REORDER
  LISTENING_CHOICE
  DICTATION
  SPEAKING
  READING_COMPREHENSION
  TRANSLATION
  SHORT_ANSWER
  WRITING
}

enum PublicationStatus {
  DRAFT
  AI_GENERATED
  REVIEWED
  PUBLISHED
  REJECTED
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Book {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  level     String?
  order     Int
  units     Unit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@unique([courseId, order])
}

model Unit {
  id          String       @id @default(cuid())
  bookId      String
  book        Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number      Int
  titleKo     String?
  titleVi     String?
  description String?
  sections    Section[]
  vocabulary Vocabulary[]
  grammar     GrammarPoint[]
  quizzes     QuizItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([bookId, number])
}

model Section {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  skill     Skill
  title     String
  order     Int
  sourceRef String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, skill, order])
}

model Vocabulary {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  korean     String
  meaningVi  String
  partOfSpeech String?
  exampleKo  String?
  exampleVi  String?
  sourceRef  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([unitId])
  @@index([korean])
}

model GrammarPoint {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String
  structure   String
  meaningVi   String?
  explanation String?
  usage       Json?
  examples    Json?
  sourceRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([unitId])
}

model QuizItem {
  id          String            @id @default(cuid())
  unitId      String
  unit        Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  skill       Skill
  type        QuizType
  difficulty  Int               @default(1)
  prompt      String
  content     Json?
  choices     Json?
  answer      Json
  explanation String?
  sourceRef   String?
  status      PublicationStatus @default(DRAFT)
  aiGenerated Boolean           @default(false)
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([unitId, skill])
  @@index([status])
}
