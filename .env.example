# AI content ingestion
# Copy to .env.local and insert your API key.
OPENAI_API_KEY=

# Content extraction / lesson generation / validation.
OPENAI_CONTENT_MODEL=gpt-6-luna

# Optional separate vision model for scanned-PDF OCR.
# Leave empty to reuse OPENAI_CONTENT_MODEL.
OPENAI_OCR_MODEL=

# MCP Bridge
# Local development may leave this empty.
# Set a long random token before exposing /mcp through a tunnel or deployment.
HANEUL_MCP_TOKEN=

# Optional custom directory for the local import queue.
# Default: <project>/.haneul/import-jobs
HANEUL_IMPORT_DIR=

# Optional persistent directory for MCP event subscriptions.
# Default: <project>/.haneul/mcp-events
HANEUL_EVENT_DIR=
